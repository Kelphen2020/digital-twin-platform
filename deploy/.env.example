# Copy to deploy/.env (or export in the shell) for docker compose.
# Never commit real secrets.

# Signing key for user JWTs (P2 auth). Change in any shared environment.
JWT_SECRET=dev-secret-change-me

# Optional shared header required by POST /api/ingest/detections.
# Leave empty to keep the machine ingest endpoint open on a trusted network.
INGEST_TOKEN=

# Docker Hub mirror fallback for networks that cannot reach the default registry.
POSTGIS_IMAGE=postgis/postgis:16-3.4

# Multi-replica deployments: replicas 2..N forward ingest to the primary API,
# e.g. INGEST_FALLBACK_URL=http://dtp-api-primary:8080 . Leave empty on the primary.
INGEST_FALLBACK_URL=
